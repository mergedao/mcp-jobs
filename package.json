{
  "name": "mcp-jobs",
  "version": "2.0.0",
  "description": "MCP server for job search across BOSS Zhipin, Liepin, 51job, and Zhaopin, with original-site application handoff and local job tracking.",
  "main": "./dist/index.js",
  "bin": {
    "mcp-jobs": "./dist/mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "pnpm build && node --test test/*.test.cjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "job-search",
    "job-tracker",
    "workbuddy",
    "zhipin",
    "liepin",
    "51job",
    "zhaopin"
  ],
  "author": "mergedao",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@types/cheerio": "^0.22.35",
    "@types/node": "^20.11.19",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.7",
    "playwright": "^1.65.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist",
    "skill",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mergedao/mcp-jobs.git"
  },
  "homepage": "https://github.com/mergedao/mcp-jobs#readme",
  "bugs": {
    "url": "https://github.com/mergedao/mcp-jobs/issues"
  }
}
